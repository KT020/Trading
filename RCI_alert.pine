//@version=5
strategy("RCI_alert", overlay=true, default_qty_value=1, pyramiding=2)

// ==================== 入力パラメーター ====================

// ---- RCI設定 ----
rciSuperShortLength = input.int(7, title="①期間 超短期", minval=1, group="RCI設定")
rciShortLength       = input.int(9, title="②期間 短期", minval=1, group="RCI設定")
rciMidLength         = input.int(26, title="③期間 中期", minval=1, group="RCI設定")
rciLongLength        = input.int(52, title="④期間 長期", minval=1, group="RCI設定")
rciOversold          = input.int(20, title="⑤売られすぎ水準", group="RCI設定")
rciOverbought        = input.int(80, title="⑥買われすぎ水準", group="RCI設定")
rciBuyLevel          = input.int(-10, title="⑦買い水準", group="RCI設定")
rciSellLevel         = input.int(10, title="⑧売り水準", group="RCI設定")

// ---- 決済設定 ----
tpPips = input.float(7.2, title="⑨利確幅(pips)", minval=0.0, step=0.1, group="決済設定")
slPips = input.float(14.4, title="⑩損切り幅(pips)", minval=0.0, step=0.1, group="決済設定")

// ==================== 指標計算 ====================

// ---- RCI ----
f_rci(src, len) =>
    d = 0.0
    for i = 0 to len - 1
        rank = 1
        for j = 0 to len - 1
            if src[j] > src[i]
                rank += 1
        d += math.pow(i + 1 - rank, 2)
    (1 - 6 * d / (len * (len * len - 1))) * 100

rciSuperShort = f_rci(close, rciSuperShortLength)
rciShort      = f_rci(close, rciShortLength)
rciMid        = f_rci(close, rciMidLength)
rciLong       = f_rci(close, rciLongLength)

plot(rciSuperShort, title="RCI超短期", color=color.orange)
plot(rciShort, title="RCI短期", color=color.red)
plot(rciMid, title="RCI中期", color=color.blue)
plot(rciLong, title="RCI長期", color=color.green)

// ==================== エントリー / エグジット ロジック ====================

// ---- pips → ticks 変換 ----
tpTicks = tpPips * 10
slTicks = slPips * 10

// ---- エントリー条件 ----
buySignal  = ta.crossover(rciMid, rciBuyLevel) and rciLong <= rciOversold
sellSignal = ta.crossunder(rciMid, rciSellLevel) and rciLong >= rciOverbought

// ---- ポジション管理 ----
if buySignal
    if strategy.position_size < 0
        strategy.entry("Buy", strategy.long, comment="ドテン買い")
    else if strategy.position_size > 0
        strategy.entry("Buy", strategy.long, comment="ピラミッティング買い")
    else
        strategy.entry("Buy", strategy.long, comment="新規買い")

if sellSignal
    if strategy.position_size > 0
        strategy.entry("Sell", strategy.short, comment="ドテン売り")
    else if strategy.position_size < 0
        strategy.entry("Sell", strategy.short, comment="ピラミッティング売り")
    else
        strategy.entry("Sell", strategy.short, comment="新規売り")

// ---- 決済（利確・損切り） ----
strategy.exit("Buy Exit", from_entry="Buy", profit=tpTicks, loss=slTicks)
strategy.exit("Sell Exit", from_entry="Sell", profit=tpTicks, loss=slTicks)

// ==================== 描画 ====================
plotshape(buySignal, title="買いシグナル", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(sellSignal, title="売りシグナル", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
