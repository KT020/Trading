//@version=5
strategy("RCI_alert", overlay=true, default_qty_value=1, pyramiding=2)

// ==================== 入力パラメーター ====================

// ---- RCI設定 ----
rciSuperShortLength = input.int(7, title="①期間 超短期", minval=1, group="RCI設定")
rciShortLength       = input.int(9, title="②期間 短期", minval=1, group="RCI設定")
rciMidLength         = input.int(26, title="③期間 中期", minval=1, group="RCI設定")
rciLongLength        = input.int(52, title="④期間 長期", minval=1, group="RCI設定")
rciOversold          = input.int(-80, title="⑤売られすぎ水準", group="RCI設定")
rciOverbought        = input.int(80, title="⑥買われすぎ水準", group="RCI設定")
rciBuyLevel          = input.int(-10, title="⑦買い水準", group="RCI設定")
rciSellLevel         = input.int(10, title="⑧売り水準", group="RCI設定")

// ---- 決済設定 ----
slPips = input.float(14.4, title="⑨損切り幅(pips)", minval=0.0, step=0.1, group="決済設定")
forceCloseMinutes = input.int(8, title="⑩強制決済（分）", minval=0, group="決済設定")
slConfirmBars = input.int(3, title="⑪損切り判定 待機バー数", minval=0, group="決済設定")

// ---- 稼働時間（Asia/Tokyo, JST） ----
h00 = input.bool(true, title="00", group="稼働時間", inline="h0")
h01 = input.bool(true, title="01", group="稼働時間", inline="h0")
h02 = input.bool(true, title="02", group="稼働時間", inline="h0")
h03 = input.bool(true, title="03", group="稼働時間", inline="h0")
h04 = input.bool(true, title="04", group="稼働時間", inline="h0")
h05 = input.bool(true, title="05", group="稼働時間", inline="h0")
h06 = input.bool(true, title="06", group="稼働時間", inline="h0")
h07 = input.bool(true, title="07", group="稼働時間", inline="h0")
h08 = input.bool(true, title="08", group="稼働時間", inline="h1")
h09 = input.bool(true, title="09", group="稼働時間", inline="h1")
h10 = input.bool(true, title="10", group="稼働時間", inline="h1")
h11 = input.bool(true, title="11", group="稼働時間", inline="h1")
h12 = input.bool(true, title="12", group="稼働時間", inline="h1")
h13 = input.bool(true, title="13", group="稼働時間", inline="h1")
h14 = input.bool(true, title="14", group="稼働時間", inline="h1")
h15 = input.bool(true, title="15", group="稼働時間", inline="h1")
h16 = input.bool(true, title="16", group="稼働時間", inline="h2")
h17 = input.bool(true, title="17", group="稼働時間", inline="h2")
h18 = input.bool(true, title="18", group="稼働時間", inline="h2")
h19 = input.bool(true, title="19", group="稼働時間", inline="h2")
h20 = input.bool(true, title="20", group="稼働時間", inline="h2")
h21 = input.bool(true, title="21", group="稼働時間", inline="h2")
h22 = input.bool(true, title="22", group="稼働時間", inline="h2")
h23 = input.bool(true, title="23", group="稼働時間", inline="h2")

// ==================== 指標計算 ====================

// ---- RCI ----
f_rci(src, len) =>
    d = 0.0
    for i = 0 to len - 1
        rank = 1
        for j = 0 to len - 1
            if src[j] > src[i]
                rank += 1
        d += math.pow(i + 1 - rank, 2)
    (1 - 6 * d / (len * (len * len - 1))) * 100

rciSuperShort = f_rci(close, rciSuperShortLength)
rciShort      = f_rci(close, rciShortLength)
rciMid        = f_rci(close, rciMidLength)
rciLong       = f_rci(close, rciLongLength)

// RCIの可視化は別ペインのRCI_alert_display.pineを併用してください
// （overlay=trueの本ストラテジーで描画すると価格スケールが潰れるため）

// ---- 稼働時間（Asia/Tokyo, JST） ----
hoursEnabled = array.from(h00, h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23)
currentHour   = hour(time, "Asia/Tokyo")
currentMinute = minute(time, "Asia/Tokyo")
nextHour        = (currentHour + 1) % 24
inTradingTime   = array.get(hoursEnabled, currentHour)
nextHourEnabled = array.get(hoursEnabled, nextHour)
isNotLastBar    = not (currentMinute == 59 and not nextHourEnabled)

// ==================== エントリー / エグジット ロジック ====================

// ---- pips → ticks 変換 ----
slTicks = slPips * 10

// ---- エントリー条件 ----
buySig  = ta.crossover(rciMid, rciBuyLevel) and rciLong <= rciOversold
sellSig = ta.crossunder(rciMid, rciSellLevel) and rciLong >= rciOverbought

buySignal  = buySig and inTradingTime and isNotLastBar
sellSignal = sellSig and inTradingTime and isNotLastBar

// ---- ポジション管理 ----
if buySignal
    if strategy.position_size < 0
        strategy.entry("Buy", strategy.long, comment="ドテン買い")
    else if strategy.position_size > 0
        strategy.entry("Buy", strategy.long, comment="ピラミッティング買い")
    else
        strategy.entry("Buy", strategy.long, comment="新規買い")

if sellSignal
    if strategy.position_size > 0
        strategy.entry("Sell", strategy.short, comment="ドテン売り")
    else if strategy.position_size < 0
        strategy.entry("Sell", strategy.short, comment="ピラミッティング売り")
    else
        strategy.entry("Sell", strategy.short, comment="新規売り")

// ---- 決済（RCI水準） ----
var bool reachedOB     = false
var bool reachedOS     = false
var int  crossBarLong  = na
var int  crossBarShort = na

isNewLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
isNewShort = strategy.position_size < 0 and strategy.position_size[1] >= 0

if isNewLong
    reachedOB := false
    crossBarLong := na
if isNewShort
    reachedOS := false
    crossBarShort := na

if strategy.position_size > 0
    if ta.crossover(rciMid, rciSellLevel)
        crossBarLong := bar_index
    if rciMid >= rciOverbought
        reachedOB := true

if strategy.position_size < 0
    if ta.crossunder(rciMid, rciBuyLevel)
        crossBarShort := bar_index
    if rciMid <= rciOversold
        reachedOS := true

barsSinceCrossLong  = na(crossBarLong) ? na : bar_index - crossBarLong
barsSinceCrossShort = na(crossBarShort) ? na : bar_index - crossBarShort

// 利確: 中期RCIが利確水準（買われすぎ/売られすぎ）に到達
tpLongCond  = strategy.position_size > 0 and rciMid >= rciOverbought
tpShortCond = strategy.position_size < 0 and rciMid <= rciOversold

if tpLongCond
    strategy.close("Buy", comment="利確(RCI)")
if tpShortCond
    strategy.close("Sell", comment="利確(RCI)")

// 損切り①: 買われすぎ/売られすぎに未到達のまま、上抜け/下抜けから待機バー数経過後に反転
slLongRciCond  = strategy.position_size > 0 and not reachedOB and not na(barsSinceCrossLong) and barsSinceCrossLong >= slConfirmBars and rciMid < rciSellLevel
slShortRciCond = strategy.position_size < 0 and not reachedOS and not na(barsSinceCrossShort) and barsSinceCrossShort >= slConfirmBars and rciMid > rciBuyLevel

if slLongRciCond
    strategy.close("Buy", comment="損切り(RCI反転)")
if slShortRciCond
    strategy.close("Sell", comment="損切り(RCI反転)")

// 損切り②: 損切り幅(pips)に到達
strategy.exit("Buy Exit", from_entry="Buy", loss=slTicks)
strategy.exit("Sell Exit", from_entry="Sell", loss=slTicks)

// ---- 稼働時間外の全決済 ----
prevInTradingTime = inTradingTime[1]
tradingTimeEnded  = prevInTradingTime and not inTradingTime and strategy.position_size != 0

sellMsg = "close_all_sell"
buyMsg  = "close_all_buy"

if tradingTimeEnded
    if strategy.position_size > 0
        alert(sellMsg, alert.freq_once_per_bar)
        strategy.close("Buy", comment="稼働時間終了")
    else if strategy.position_size < 0
        alert(buyMsg, alert.freq_once_per_bar)
        strategy.close("Sell", comment="稼働時間終了")

// ---- 強制決済（時間ベース） ----
if strategy.opentrades > 0
    entryTime      = strategy.opentrades.entry_time(0)
    elapsedMinutes = (time - entryTime) / 1000 / 60
    if elapsedMinutes >= forceCloseMinutes
        if strategy.position_size > 0
            strategy.close("Buy", qty=1, comment="時間決済", alert_message=sellMsg)
        else if strategy.position_size < 0
            strategy.close("Sell", qty=1, comment="時間決済", alert_message=buyMsg)

// ==================== 描画 ====================
plotshape(buySignal, title="買いシグナル", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(sellSignal, title="売りシグナル", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
