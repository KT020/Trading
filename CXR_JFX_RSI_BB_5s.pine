//@version=5
strategy("CXR/JFX_RSI_BB_5s", overlay=true, default_qty_value=1, pyramiding=2)

// ==================== 入力パラメーター ====================

// ---- BB設定 ----
bbLength = input.int(20, title="①期間", minval=1, group="BB設定")
bbMult   = input.float(2.0, title="②標準偏差", minval=0.001, step=0.1, group="BB設定")

// ---- RSI設定 ----
rsiLength     = input.int(14, title="③期間", minval=1, group="RSI設定")
rsiOversold   = input.int(30, title="④売られすぎ水準", minval=0, maxval=100, group="RSI設定")
rsiOverbought = input.int(70, title="⑤買われすぎ水準", minval=0, maxval=100, group="RSI設定")

// ---- 決済設定 ----
tpPips = input.float(7.2, title="⑥利確幅(pips)", minval=0.0, step=0.1, group="決済設定")
slPips = input.float(14.4, title="⑦損切り幅(pips)", minval=0.0, step=0.1, group="決済設定")

// ---- ボラティリティフィルター ----
volFilterEnabled = input.bool(true, title="フィルター有効/無効", group="ボラティリティフィルター")
atrTimeframe      = input.timeframe("60", title="ATR参照タイムフレーム", group="ボラティリティフィルター")
atrLength         = input.int(14, title="⑨ATR期間", minval=1, group="ボラティリティフィルター")
atrAvgLength      = input.int(50, title="⑩ATR平均期間", minval=1, group="ボラティリティフィルター")
volStopMult       = input.float(1.5, title="⑪平均ATR×N", minval=0.0, step=0.1, group="ボラティリティフィルター")

// ---- トレンドフィルター ----
trendFilterEnabled = input.bool(true, title="フィルター有効/無効", group="トレンドフィルター")
adxTimeframe        = input.timeframe("60", title="ADX参照タイムフレーム", group="トレンドフィルター")
adxLength           = input.int(14, title="⑫ADX期間", minval=1, group="トレンドフィルター")
adxThreshold        = input.float(25.0, title="⑬ADX閾値", minval=0.0, step=0.1, group="トレンドフィルター")

// ---- 稼働時間（Asia/Tokyo, JST） ----
h00 = input.bool(true, title="00", group="稼働時間", inline="h0")
h01 = input.bool(true, title="01", group="稼働時間", inline="h0")
h02 = input.bool(true, title="02", group="稼働時間", inline="h0")
h03 = input.bool(true, title="03", group="稼働時間", inline="h0")
h04 = input.bool(true, title="04", group="稼働時間", inline="h0")
h05 = input.bool(true, title="05", group="稼働時間", inline="h0")
h06 = input.bool(true, title="06", group="稼働時間", inline="h0")
h07 = input.bool(true, title="07", group="稼働時間", inline="h0")
h08 = input.bool(true, title="08", group="稼働時間", inline="h1")
h09 = input.bool(true, title="09", group="稼働時間", inline="h1")
h10 = input.bool(true, title="10", group="稼働時間", inline="h1")
h11 = input.bool(true, title="11", group="稼働時間", inline="h1")
h12 = input.bool(true, title="12", group="稼働時間", inline="h1")
h13 = input.bool(true, title="13", group="稼働時間", inline="h1")
h14 = input.bool(true, title="14", group="稼働時間", inline="h1")
h15 = input.bool(true, title="15", group="稼働時間", inline="h1")
h16 = input.bool(true, title="16", group="稼働時間", inline="h2")
h17 = input.bool(true, title="17", group="稼働時間", inline="h2")
h18 = input.bool(true, title="18", group="稼働時間", inline="h2")
h19 = input.bool(true, title="19", group="稼働時間", inline="h2")
h20 = input.bool(true, title="20", group="稼働時間", inline="h2")
h21 = input.bool(true, title="21", group="稼働時間", inline="h2")
h22 = input.bool(true, title="22", group="稼働時間", inline="h2")
h23 = input.bool(true, title="23", group="稼働時間", inline="h2")

// ==================== 指標計算 ====================

// ---- ボリンジャーバンド ----
bbBasis = ta.sma(close, bbLength)
bbDev   = bbMult * ta.stdev(close, bbLength)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

pUpper = plot(bbUpper, title="BB Upper", color=color.red)
pBasis = plot(bbBasis, title="BB Basis", color=color.gray)
pLower = plot(bbLower, title="BB Lower", color=color.blue)
fill(pUpper, pLower, title="BB Fill", color=color.new(color.gray, 92))

// ---- RSI ----
rsiValue = ta.rsi(close, rsiLength)

// ---- ボラティリティフィルター ----
atrValue = request.security(syminfo.tickerid, atrTimeframe, ta.atr(atrLength), lookahead=barmerge.lookahead_off)
atrAvg   = ta.sma(atrValue, atrAvgLength)
normalVola   = atrValue <= atrAvg * volStopMult
volFilterPass = not volFilterEnabled or normalVola
highVolaStop  = volFilterEnabled and not normalVola

// ---- トレンドフィルター ----
adxSecurity() =>
    [_, _, adx] = ta.dmi(adxLength, adxLength)
    adx
adxValue = request.security(syminfo.tickerid, adxTimeframe, adxSecurity(), lookahead=barmerge.lookahead_off)
isRanging       = adxValue < adxThreshold
trendFilterPass = not trendFilterEnabled or isRanging
trendStop       = trendFilterEnabled and not isRanging

// ---- フィルター状態の背景色 ----
bgColor = highVolaStop and trendStop ? color.new(color.purple, 85) : highVolaStop ? color.new(color.orange, 88) : trendStop ? color.new(color.red, 88) : na
bgcolor(bgColor, title="フィルター状態")

// ---- 稼働時間（Asia/Tokyo, JST） ----
hoursEnabled = array.from(h00, h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23)
currentHour   = hour(time, "Asia/Tokyo")
currentMinute = minute(time, "Asia/Tokyo")
nextHour        = (currentHour + 1) % 24
inTradingTime   = array.get(hoursEnabled, currentHour)
nextHourEnabled = array.get(hoursEnabled, nextHour)
isNotLastBar    = not (currentMinute == 59 and not nextHourEnabled)

// ==================== エントリー / エグジット ロジック ====================

// ---- pips → ticks 変換 ----
tpTicks = tpPips * 10
slTicks = slPips * 10

// ---- エントリー条件 ----
buySignal  = ta.crossunder(close, bbLower) and rsiValue <= rsiOversold and volFilterPass and trendFilterPass and inTradingTime and isNotLastBar
sellSignal = ta.crossover(close, bbUpper) and rsiValue >= rsiOverbought and volFilterPass and trendFilterPass and inTradingTime and isNotLastBar

// ---- ポジション管理 ----
if buySignal
    if strategy.position_size < 0
        strategy.entry("Buy", strategy.long, comment="ドテン買い")
    else if strategy.position_size > 0
        strategy.entry("Buy", strategy.long, comment="ピラミッティング買い")
    else
        strategy.entry("Buy", strategy.long, comment="新規買い")

if sellSignal
    if strategy.position_size > 0
        strategy.entry("Sell", strategy.short, comment="ドテン売り")
    else if strategy.position_size < 0
        strategy.entry("Sell", strategy.short, comment="ピラミッティング売り")
    else
        strategy.entry("Sell", strategy.short, comment="新規売り")

// ---- 決済（利確・損切り） ----
strategy.exit("Buy Exit", from_entry="Buy", profit=tpTicks, loss=slTicks)
strategy.exit("Sell Exit", from_entry="Sell", profit=tpTicks, loss=slTicks)

// ---- 稼働時間外の全決済 ----
prevInTradingTime = inTradingTime[1]
tradingTimeEnded  = prevInTradingTime and not inTradingTime and strategy.position_size != 0

sellMsg = "close_all_sell"
buyMsg  = "close_all_buy"

if tradingTimeEnded
    if strategy.position_size > 0
        alert(sellMsg, alert.freq_once_per_bar)
        strategy.close("Buy", comment="稼働時間終了")
    else if strategy.position_size < 0
        alert(buyMsg, alert.freq_once_per_bar)
        strategy.close("Sell", comment="稼働時間終了")

// ==================== 描画 ====================
plotshape(buySignal, title="買いシグナル", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(sellSignal, title="売りシグナル", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
